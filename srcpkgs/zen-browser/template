# Template file for 'zen-browser'
pkgname=zen-browser
version=1.21.6b
revision=1
only_for_archs="x86_64"
short_desc="Minimalistic web browser"
maintainer="Brian Ma <brianma360@gmail.com>"
license="MPL-2.0"
homepage="https://www.zen-browser.app/"
distfiles="https://github.com/zen-browser/desktop/releases/download/${version}/zen.linux-x86_64.tar.xz"
checksum=eff490152c21b9a55b863b9df02370c30567e1027fe388eee939ed4082b53b20

do_install() {
	# install the files
	vmkdir usr/lib/zen-browser
	vcopy * usr/lib/zen-browser
	vinstall ${FILESDIR}/zen-browser.desktop 644 usr/share/applications

	# link the binary
	vmkdir usr/bin/
	ln -s /usr/lib/zen-browser/zen ${DESTDIR}/usr/bin/

	# install icons
	for icon in browser/chrome/icons/default/default*.png; do
		size="${icon##*default}"
		size="${size%.png}"
		vinstall browser/chrome/icons/default/default${size}.png 644 usr/share/icons/hicolor/${size}x${size}/apps zen-browser.png
	done
}

# Add the necessary dependencies if there are any
depends="libX11 libXcomposite libXdamage libXext libXfixes libXt libXtst \
libxkbcommon libxkbcommon-x11 libpng glib gtk+3"

