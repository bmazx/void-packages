# Template file for 'mullvad-vpn'
pkgname=mullvad-vpn
version=2026.3
revision=1
only_for_archs="x86_64"
short_desc="VPN client software for the Mullvad VPN service"
hostmakedepends="tar xz"
maintainer="Brian <brianma360@gmail.com>"
license="GPL-3.0"
homepage="https://mullvad.net/en"
distfiles="https://github.com/mullvad/mullvadvpn-app/releases/download/${version}/MullvadVPN-${version}_amd64.deb"
checksum=38c6ee73ae80870688560922a28525b6d0dacc62c2e410938863d7038e931aca
skip_extraction="MullvadVPN-${version}_amd64.deb"

do_extract() {
	mkdir -p ${wrksrc}
	cd ${wrksrc}
	ar x ${XBPS_SRCDISTDIR}/${pkgname}-${version}/MullvadVPN-${version}_amd64.deb
	tar -xf data.tar.xz
}

do_install() {
	vcopy usr/bin/ usr/bin/
	vcopy opt opt/
	vmkdir usr/share/icons/
	vcopy usr/share/icons/* usr/share/icons/
	vinstall usr/share/applications/mullvad-vpn.desktop 644 usr/share/applications/

	ln -s /opt/Mullvad\ VPN/mullvad-gui ${DESTDIR}/usr/bin/
	ln -s /opt/Mullvad\ VPN/mullvad-vpn ${DESTDIR}/usr/bin/

	vsv mullvad-daemon
}
